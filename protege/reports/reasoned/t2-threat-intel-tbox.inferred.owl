    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://kgcourse.org/ontology/threat-intel#Advisory -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Advisory">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>GitHub Advisory Database / OSV（本切片未使用）</terms:source>
        <rdfs:comment xml:lang="zh">厂商公告 / GHSA / OSV 公告；本切片未实例化（源未提供稳定外部 ID）。</rdfs:comment>
        <rdfs:isDefinedBy>GitHub Advisory Database / OSV（本切片未使用）</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">安全公告</rdfs:label>
        <skos:scopeNote xml:lang="zh">预留扩展类（GHSA/OSV 未纳入本切片），用于承载厂商公告与修复版本。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#AttackPattern -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#AttackPattern">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>MITRE CAPEC 3.9</terms:source>
        <rdfs:comment xml:lang="zh">CAPEC 攻击模式，描述攻击者如何利用某类弱点。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE CAPEC 3.9</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">攻击模式</rdfs:label>
        <skos:scopeNote xml:lang="zh">CAPEC 描述攻击者如何利用某类弱点，是弱点与具体 ATT&amp;CK 技术之间的中间层。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Campaign -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Campaign">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>MITRE ATT&amp;CK Enterprise STIX</terms:source>
        <rdfs:comment xml:lang="zh">MITRE ATT&amp;CK campaign（C####）。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE ATT&amp;CK Enterprise STIX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">攻击活动</rdfs:label>
        <skos:scopeNote xml:lang="zh">与官方 ATT&amp;CK 本体对齐的预留层；本切片没有活动级数据，未实例化。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#DetectionRule -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#DetectionRule">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>SigmaHQ/sigma（DRL 1.1，仅元数据）</terms:source>
        <rdfs:comment xml:lang="zh">Sigma 检测规则（以 sigma:&lt;UUID&gt; 为主键）；本切片只保留元数据，不复制规则正文。</rdfs:comment>
        <rdfs:isDefinedBy>SigmaHQ/sigma（DRL 1.1，仅元数据）</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">检测规则</rdfs:label>
        <skos:scopeNote xml:lang="zh">Sigma 规则的 attack.tXXXX 标签提供检测覆盖证据（仅元数据，符合 DRL 1.1）。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Document -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Document">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:source>Dublin Core Metadata Element Set (ISO 15836)</terms:source>
        <rdfs:comment xml:lang="zh">语料文档节点（CVE 记录、KEV 条目、ATT&amp;CK 条目等），用于 mentioned_in 溯源。</rdfs:comment>
        <rdfs:isDefinedBy>Dublin Core Metadata Element Set (ISO 15836)</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">来源文档</rdfs:label>
        <skos:scopeNote xml:lang="zh">三级溯源要求每个事实能回到来源文档与许可证，必须有文档节点承载这两项元数据。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Exploit -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Exploit">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>ExploitDB（GPLv2+，本切片未使用）</terms:source>
        <rdfs:comment xml:lang="zh">公开 PoC / ExploitDB 条目；本切片未实例化（源未提供稳定外部 ID）。</rdfs:comment>
        <rdfs:isDefinedBy>ExploitDB（GPLv2+，本切片未使用）</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">利用代码</rdfs:label>
        <skos:scopeNote xml:lang="zh">预留扩展类（ExploitDB 未纳入本切片），保留是为了说明本体可扩展而不改主键策略。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#ExploitationRecord -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#ExploitationRecord">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>CISA Known Exploited Vulnerabilities Catalog</terms:source>
        <rdfs:comment xml:lang="zh">CISA KEV 目录中的一条记录，携带 dateAdded / dueDate / knownRansomwareCampaignUse。</rdfs:comment>
        <rdfs:isDefinedBy>CISA Known Exploited Vulnerabilities Catalog</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">在野利用记录</rdfs:label>
        <skos:scopeNote xml:lang="zh">KEV 条目是「已被在野利用」的权威记录；正文无独立编号，主键由所属 CVE 派生。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Group -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Group">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>MITRE ATT&amp;CK Enterprise STIX</terms:source>
        <rdfs:comment xml:lang="zh">MITRE ATT&amp;CK intrusion-set（G####）。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE ATT&amp;CK Enterprise STIX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">攻击组织</rdfs:label>
        <skos:scopeNote xml:lang="zh">组织—技术关系用于威胁行为体画像；数据来自 ATT&amp;CK intrusion-set。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Malware -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Malware">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#Software"/>
        <terms:source>MITRE ATT&amp;CK Enterprise STIX</terms:source>
        <rdfs:comment xml:lang="zh">ATT&amp;CK type=malware 的软件。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE ATT&amp;CK Enterprise STIX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">恶意软件</rdfs:label>
        <skos:scopeNote xml:lang="zh">ATT&amp;CK 的 malware 子类；具体 kind 保存在实体属性中。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Mitigation -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Mitigation">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>MITRE ATT&amp;CK Enterprise STIX</terms:source>
        <rdfs:comment xml:lang="zh">MITRE ATT&amp;CK course-of-action（M####），按 mitigates 关系作用于技术。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE ATT&amp;CK Enterprise STIX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">缓解措施</rdfs:label>
        <skos:scopeNote xml:lang="zh">ATT&amp;CK course-of-action 与技术的 mitigates 关系支撑防护建议。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Product -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Product">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>NIST IR 7695 CPE 2.3 / NVD configurations</terms:source>
        <rdfs:comment xml:lang="zh">CPE 2.3 标识的软件、操作系统或硬件产品（含版本）。</rdfs:comment>
        <rdfs:isDefinedBy>NIST IR 7695 CPE 2.3 / NVD configurations</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">产品/平台</rdfs:label>
        <skos:scopeNote xml:lang="zh">CPE 2.3 是 NVD 对受影响平台的结构化标识，支撑「某型号设备暴露面」查询。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#SecurityConcept -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#SecurityConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:source>Noy &amp; McGuinness, Ontology Development 101 (七步法)</terms:source>
        <rdfs:comment xml:lang="zh">威胁情报域顶层概念；所有领域类都是它的子类。</rdfs:comment>
        <rdfs:isDefinedBy>Noy &amp; McGuinness, Ontology Development 101 (七步法)</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">安全概念</rdfs:label>
        <skos:scopeNote xml:lang="zh">先立顶层概念作为继承根，统一命名空间，避免各类各自为政（七步法第 3 步）。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Software -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Software">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>MITRE ATT&amp;CK Enterprise STIX</terms:source>
        <rdfs:comment xml:lang="zh">MITRE ATT&amp;CK software（S####），下分恶意软件与工具。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE ATT&amp;CK Enterprise STIX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">攻击软件</rdfs:label>
        <skos:scopeNote xml:lang="zh">S 编号不区分恶意软件与工具，统一父类可让三种方法按同一类型对齐。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Tactic -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Tactic">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>MITRE ATT&amp;CK Enterprise STIX</terms:source>
        <rdfs:comment xml:lang="zh">MITRE ATT&amp;CK Tactic（TA####），技术按 kill_chain_phases 归属。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE ATT&amp;CK Enterprise STIX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">战术</rdfs:label>
        <skos:scopeNote xml:lang="zh">kill_chain_phases 给出技术所属攻击阶段，支撑按战术汇总。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Technique -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Technique">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>MITRE ATT&amp;CK Enterprise STIX</terms:source>
        <rdfs:comment xml:lang="zh">MITRE ATT&amp;CK Technique（T#### / T####.###）。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE ATT&amp;CK Enterprise STIX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">攻击技术</rdfs:label>
        <skos:scopeNote xml:lang="zh">ATT&amp;CK 技术是检测覆盖分析与攻击链还原的基本单位。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Tool -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Tool">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#Software"/>
        <terms:source>MITRE ATT&amp;CK Enterprise STIX</terms:source>
        <rdfs:comment xml:lang="zh">ATT&amp;CK type=tool 的软件。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE ATT&amp;CK Enterprise STIX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">攻击工具</rdfs:label>
        <skos:scopeNote xml:lang="zh">ATT&amp;CK 的 tool 子类；具体 kind 保存在实体属性中。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Vendor -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Vendor">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>NIST IR 7695 CPE 2.3 / CISA KEV</terms:source>
        <rdfs:comment xml:lang="zh">CPE vendor 字段或 KEV vendorProject 标识的产品厂商。</rdfs:comment>
        <rdfs:isDefinedBy>NIST IR 7695 CPE 2.3 / CISA KEV</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">厂商</rdfs:label>
        <skos:scopeNote xml:lang="zh">CPE 的 vendor 段可独立成节点，便于按厂商聚合暴露面；KEV 也提供 vendorProject。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Vulnerability -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Vulnerability">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>CVE Program (cveawg.mitre.org) / NVD 2.0</terms:source>
        <rdfs:comment xml:lang="zh">CVE 编号标识的具体漏洞实例。</rdfs:comment>
        <rdfs:isDefinedBy>CVE Program (cveawg.mitre.org) / NVD 2.0</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">漏洞</rdfs:label>
        <skos:scopeNote xml:lang="zh">CVE 是跨 CWE/CPE/KEV/ATT&amp;CK 关联的锚点，官方编号可直接作为主键。</skos:scopeNote>
    </owl:Class>
    


    <!-- http://kgcourse.org/ontology/threat-intel#Weakness -->

    <owl:Class rdf:about="http://kgcourse.org/ontology/threat-intel#Weakness">
        <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <terms:source>MITRE CWE 4.20</terms:source>
        <rdfs:comment xml:lang="zh">CWE 弱点分类，描述漏洞的根因类型。</rdfs:comment>
        <rdfs:isDefinedBy>MITRE CWE 4.20</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">弱点类型</rdfs:label>
        <skos:scopeNote xml:lang="zh">CWE 给出漏洞根因分类，并官方维护到 CAPEC 的映射，是漏洞到攻击模式的桥梁。</skos:scopeNote>
    </owl:Class>
</rdf:RDF>



