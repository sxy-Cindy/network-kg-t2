<?xml version="1.0"?>
<rdf:RDF xmlns="http://kgcourse.org/inferred/t2-threat-intel-tbox.owl.ttl#"
     xml:base="http://kgcourse.org/inferred/t2-threat-intel-tbox.owl.ttl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:threat-intel="http://kgcourse.org/ontology/threat-intel#">
    <owl:Ontology rdf:about="http://kgcourse.org/inferred/t2-threat-intel-tbox.owl.ttl"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://kgcourse.org/ontology/threat-intel#alias -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#alias">
        <rdfs:label xml:lang="zh">别名</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#compatibilityNote -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#compatibilityNote">
        <rdfs:label xml:lang="zh">兼容性说明</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#confidence -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#confidence">
        <rdfs:label xml:lang="zh">抽取置信度</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#dataSnapshot -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#dataSnapshot">
        <rdfs:label xml:lang="zh">实例快照日期</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#evidence -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#evidence">
        <rdfs:label xml:lang="zh">原文证据</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#extractionMethod -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#extractionMethod">
        <rdfs:label xml:lang="zh">抽取方法</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#license -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#license">
        <rdfs:label xml:lang="zh">许可证</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#licenseCode -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#licenseCode">
        <rdfs:label xml:lang="zh">许可证代码</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#modelingNote -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#modelingNote">
        <rdfs:label xml:lang="zh">建模备注</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#officialId -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#officialId">
        <rdfs:label xml:lang="zh">官方编号</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#ontologyVersion -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#ontologyVersion">
        <rdfs:label xml:lang="zh">本体版本</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#retrieved -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#retrieved">
        <rdfs:label xml:lang="zh">取数时间</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#sourceDoc -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#sourceDoc">
        <rdfs:label xml:lang="zh">来源文档</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#sourceId -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#sourceId">
        <rdfs:label xml:lang="zh">原始 ID</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#sourceName -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#sourceName">
        <rdfs:label xml:lang="zh">数据源名称</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#sourceUrl -->

    <owl:AnnotationProperty rdf:about="http://kgcourse.org/ontology/threat-intel#sourceUrl">
        <rdfs:label xml:lang="zh">数据源 URL</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created">
        <rdfs:label xml:lang="zh">创建时间</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified">
        <rdfs:label xml:lang="zh">修改时间</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source">
        <rdfs:label xml:lang="zh">来源</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#scopeNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote">
        <rdfs:label xml:lang="zh">建模理由</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://kgcourse.org/ontology/threat-intel#affects_product -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#affects_product">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Vulnerability"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Product"/>
        <terms:source>NVD 2.0 configurations[].cpeMatch[].criteria</terms:source>
        <rdfs:comment xml:lang="zh">漏洞影响的 CPE 产品（含版本）。</rdfs:comment>
        <rdfs:isDefinedBy>NVD 2.0 configurations[].cpeMatch[].criteria</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">影响产品</rdfs:label>
        <skos:scopeNote xml:lang="zh">受影响的平台由 NVD 以 CPE 枚举，是结构化的官方事实。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#announced_in -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#announced_in">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Vulnerability"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Advisory"/>
        <terms:source>CVE reference tags: vendor-advisory / GHSA</terms:source>
        <rdfs:comment xml:lang="zh">漏洞的官方/厂商公告（本切片未实例化）。</rdfs:comment>
        <rdfs:isDefinedBy>CVE reference tags: vendor-advisory / GHSA</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">公告于</rdfs:label>
        <skos:scopeNote xml:lang="zh">公告关系来自官方参考链接的 advisory 标签；本切片未实例化公告节点。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#belongs_to_tactic -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#belongs_to_tactic">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Tactic"/>
        <terms:source>ATT&amp;CK STIX attack-pattern.kill_chain_phases</terms:source>
        <rdfs:comment xml:lang="zh">技术归属的 ATT&amp;CK 战术（kill_chain_phases）。</rdfs:comment>
        <rdfs:isDefinedBy>ATT&amp;CK STIX attack-pattern.kill_chain_phases</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">归属战术</rdfs:label>
        <skos:scopeNote xml:lang="zh">每个技术的 kill_chain_phases 直接给出所属战术。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#campaign_uses -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#campaign_uses">
        <rdfs:subPropertyOf rdf:resource="http://kgcourse.org/ontology/threat-intel#uses"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Campaign"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <terms:source>ATT&amp;CK STIX campaign --uses--&gt; attack-pattern</terms:source>
        <rdfs:comment xml:lang="zh">攻击活动使用某 ATT&amp;CK 技术。</rdfs:comment>
        <rdfs:isDefinedBy>ATT&amp;CK STIX campaign --uses--&gt; attack-pattern</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">活动使用</rdfs:label>
        <skos:scopeNote xml:lang="zh">活动级 uses 关系；本切片无 Campaign 节点，未实例化。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#detects -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#detects">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#DetectionRule"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <terms:source>Sigma rule tags attack.tXXXX</terms:source>
        <rdfs:comment xml:lang="zh">检测规则覆盖某技术（Sigma tags: attack.t####）。</rdfs:comment>
        <rdfs:isDefinedBy>Sigma rule tags attack.tXXXX</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">检测</rdfs:label>
        <skos:scopeNote xml:lang="zh">Sigma 规则用元数据标签声明检测的技术，本作业只取标签不复制规则正文。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#group_uses -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#group_uses">
        <owl:equivalentProperty>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://kgcourse.org/ontology/threat-intel#used_by"/>
            </rdf:Description>
        </owl:equivalentProperty>
        <rdfs:subPropertyOf rdf:resource="http://kgcourse.org/ontology/threat-intel#uses"/>
        <owl:inverseOf rdf:resource="http://kgcourse.org/ontology/threat-intel#used_by"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Group"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <terms:source>ATT&amp;CK STIX intrusion-set --uses--&gt; attack-pattern</terms:source>
        <rdfs:comment xml:lang="zh">攻击组织使用某 ATT&amp;CK 技术。</rdfs:comment>
        <rdfs:isDefinedBy>ATT&amp;CK STIX intrusion-set --uses--&gt; attack-pattern</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">组织使用</rdfs:label>
        <skos:scopeNote xml:lang="zh">攻击组织使用某技术，来自官方 uses 关系。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#has_weakness -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#has_weakness">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Vulnerability"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Weakness"/>
        <terms:source>NVD 2.0 weaknesses[] / CVE 5.0 problemTypes</terms:source>
        <rdfs:comment xml:lang="zh">漏洞的 CWE 弱点分类。</rdfs:comment>
        <rdfs:isDefinedBy>NVD 2.0 weaknesses[] / CVE 5.0 problemTypes</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">根因是</rdfs:label>
        <skos:scopeNote xml:lang="zh">CVE 记录与 NVD 都直接给出 CWE 分类，是根因的官方字段，不需要从正文推断。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#implemented_by -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#implemented_by">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#AttackPattern"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <terms:source>分析师 crosswalk（24 条，CC BY 4.0）</terms:source>
        <rdfs:comment xml:lang="zh">CAPEC 攻击模式在 ATT&amp;CK 中的技术实现（分析师 crosswalk，见 capec_attck_crosswalk.csv）。</rdfs:comment>
        <rdfs:isDefinedBy>分析师 crosswalk（24 条，CC BY 4.0）</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">技术上实现为</rdfs:label>
        <skos:scopeNote xml:lang="zh">MITRE 没有官方 CAPEC→ATT&amp;CK 映射，只能显式人工映射并标注 confidence，不能伪装成官方标准。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#known_exploited -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#known_exploited">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Vulnerability"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#ExploitationRecord"/>
        <terms:source>CISA KEV cveID</terms:source>
        <rdfs:comment xml:lang="zh">漏洞对应的 KEV 在野利用记录。</rdfs:comment>
        <rdfs:isDefinedBy>CISA KEV cveID</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">已被在野利用</rdfs:label>
        <skos:scopeNote xml:lang="zh">KEV 目录以 cveID 关联漏洞，语义就是「已被在野利用」。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#mentioned_in -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#mentioned_in">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Document"/>
        <terms:source>本作业的三级溯源结构（非领域事实）</terms:source>
        <rdfs:comment xml:lang="zh">实体出现在来源文档中（结构关系，用于三级溯源）。</rdfs:comment>
        <rdfs:isDefinedBy>本作业的三级溯源结构（非领域事实）</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">出现于</rdfs:label>
        <skos:scopeNote xml:lang="zh">连接实体与来源文档；不参与知识推理，路径查询默认排除文档节点。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#mitigates -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#mitigates">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Mitigation"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <terms:source>ATT&amp;CK STIX course-of-action --mitigates--&gt; attack-pattern</terms:source>
        <rdfs:comment xml:lang="zh">缓解措施作用于某技术（ATT&amp;CK mitigates）。</rdfs:comment>
        <rdfs:isDefinedBy>ATT&amp;CK STIX course-of-action --mitigates--&gt; attack-pattern</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">缓解</rdfs:label>
        <skos:scopeNote xml:lang="zh">缓解措施对技术的官方缓解关系。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#produced_by -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#produced_by">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Product"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Vendor"/>
        <terms:source>CPE 2.3 第 3 段 vendor（NIST IR 7695）</terms:source>
        <rdfs:comment xml:lang="zh">产品所属厂商。</rdfs:comment>
        <rdfs:isDefinedBy>CPE 2.3 第 3 段 vendor（NIST IR 7695）</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">由厂商生产</rdfs:label>
        <skos:scopeNote xml:lang="zh">厂商是 CPE 串的规范字段，产品到厂商是标识符自带的层级。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#relates_to_pattern -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#relates_to_pattern">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Weakness"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#AttackPattern"/>
        <terms:source>CWE XML Related_Attack_Patterns/CAPEC_ID</terms:source>
        <rdfs:comment xml:lang="zh">CWE 弱点对应的 CAPEC 攻击模式（CWE Related_Attack_Patterns）。</rdfs:comment>
        <rdfs:isDefinedBy>CWE XML Related_Attack_Patterns/CAPEC_ID</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">对应攻击模式</rdfs:label>
        <skos:scopeNote xml:lang="zh">MITRE 在 CWE 条目里官方维护到 CAPEC 的映射。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#software_uses -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#software_uses">
        <rdfs:subPropertyOf rdf:resource="http://kgcourse.org/ontology/threat-intel#uses"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Software"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <terms:source>ATT&amp;CK STIX malware/tool --uses--&gt; attack-pattern</terms:source>
        <rdfs:comment xml:lang="zh">恶意软件/工具使用某 ATT&amp;CK 技术。</rdfs:comment>
        <rdfs:isDefinedBy>ATT&amp;CK STIX malware/tool --uses--&gt; attack-pattern</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">软件使用</rdfs:label>
        <skos:scopeNote xml:lang="zh">恶意软件或工具使用某技术，来自官方 uses 关系。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#subtechnique_of -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#subtechnique_of">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <terms:source>ATT&amp;CK STIX relationship: subtechnique-of</terms:source>
        <rdfs:comment xml:lang="zh">子技术与其父技术的关系（ATT&amp;CK subtechnique-of）。</rdfs:comment>
        <rdfs:isDefinedBy>ATT&amp;CK STIX relationship: subtechnique-of</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">子技术属于</rdfs:label>
        <skos:scopeNote xml:lang="zh">官方关系对象，方向固定为子技术→父技术。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#used_by -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#used_by">
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://kgcourse.org/ontology/threat-intel#uses"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="http://kgcourse.org/ontology/threat-intel#Technique"/>
        <rdfs:range rdf:resource="http://kgcourse.org/ontology/threat-intel#Group"/>
        <terms:source>ATT&amp;CK STIX uses 的逆向视图</terms:source>
        <rdfs:comment xml:lang="zh">group_uses 的逆关系，便于从技术反查组织。</rdfs:comment>
        <rdfs:isDefinedBy>ATT&amp;CK STIX uses 的逆向视图</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">被使用</rdfs:label>
        <skos:scopeNote xml:lang="zh">为查询方便保留的逆向关系，抽取阶段不单独产出。</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://kgcourse.org/ontology/threat-intel#uses -->

    <owl:ObjectProperty rdf:about="http://kgcourse.org/ontology/threat-intel#uses">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <terms:source>ATT&amp;CK STIX relationship: uses</terms:source>
        <rdfs:comment xml:lang="zh">攻击组织/软件/活动使用某技术的抽象父属性；具体来源类用下列子属性。</rdfs:comment>
        <rdfs:isDefinedBy>ATT&amp;CK STIX relationship: uses</rdfs:isDefinedBy>
        <rdfs:label xml:lang="zh">使用</rdfs:label>
        <skos:scopeNote xml:lang="zh">STIX 的通用 uses 边；为避免域/值域含混，图中只实例化下列细分关系。</skos:scopeNote>
    </owl:ObjectProperty>
    


