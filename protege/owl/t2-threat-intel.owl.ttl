@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://kgcourse.org/instance/threat-intel#node/vendor_ietf> a :Vendor,
        owl:NamedIndividual ;
    rdfs:label "IETF" ;
    :extractionMethod "llm" ;
    :sourceId "vendor:ietf" .

<http://kgcourse.org/instance/threat-intel#node/vendor_juniper-networks> a :Vendor,
        owl:NamedIndividual ;
    rdfs:label "Juniper Networks" ;
    :extractionMethod "model" ;
    :sourceId "vendor:juniper-networks" .

<http://kgcourse.org/instance/threat-intel#node/vendor_networks> a :Vendor,
        owl:NamedIndividual ;
