  <rdf:Description rdf:about="http://kgcourse.org/ontology/threat-intel#Advisory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">安全公告</rdfs:label>
    <rdfs:comment xml:lang="zh">厂商公告 / GHSA / OSV 公告；本切片未实例化（源未提供稳定外部 ID）。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://kgcourse.org/ontology/threat-intel#SecurityConcept"/>
    <rdfs:isDefinedBy>GitHub Advisory Database / OSV（本切片未使用）</rdfs:isDefinedBy>
    <dcterms:source>GitHub Advisory Database / OSV（本切片未使用）</dcterms:source>
    <skos:scopeNote xml:lang="zh">预留扩展类（GHSA/OSV 未纳入本切片），用于承载厂商公告与修复版本。</skos:scopeNote>
  </rdf:Description>
