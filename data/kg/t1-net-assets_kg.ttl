    rdfs:isDefinedBy <kg:t1-net-assets#vlan:20> .

:IncINC-20260714 a :Incident ;
    rdfs:label "INC-20260714" ;
    rdfs:isDefinedBy <kg:t1-net-assets#inc:INC-20260714> .

