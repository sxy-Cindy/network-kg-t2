    rdfs:isDefinedBy <kg:t1-net-assets#Service:ntp> .

:ServiceSnmp a :Service ;
    rdfs:label "SNMP" ;
    rdfs:isDefinedBy <kg:t1-net-assets#Service:snmp> .

