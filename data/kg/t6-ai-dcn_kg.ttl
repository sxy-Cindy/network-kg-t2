@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://kgcourse.org/ontology/ai-dcn#> .

:ProtoMRC a :Protocol ;
    rdfs:label "MRC" ;
    rdfs:isDefinedBy <kg:t6-ai-dcn#proto:MRC> .

:ProtoRoCEv2 a :Protocol ;
    rdfs:label "RoCEv2" ;
    rdfs:isDefinedBy <kg:t6-ai-dcn#proto:RoCEv2> .

