    rdfs:isDefinedBy <kg:t6-ai-dcn#fm:packet loss> .

:FmIncast a :FailureMode ;
    rdfs:label "incast" ;
    rdfs:isDefinedBy <kg:t6-ai-dcn#fm:incast> .

:FmPathFailure a :FailureMode ;
    rdfs:label "path failure" ;
    rdfs:isDefinedBy <kg:t6-ai-dcn#fm:path failure> .

:Comp800G a :Component ;
    rdfs:label "800G" ;
    rdfs:isDefinedBy <kg:t6-ai-dcn#comp:800G> .

:Comp100G a :Component ;
    rdfs:label "100G" ;
    rdfs:isDefinedBy <kg:t6-ai-dcn#comp:100G> .

:StdOCP a :Standard ;
    rdfs:label "OCP" ;
    rdfs:isDefinedBy <kg:t6-ai-dcn#std:OCP> .

:StdUEC a :Standard ;
